# Production settings: copy to .env on the server and fill in EVERY value.
# Used by docker-compose.prod.yml (see README.md, "Serverga chiqarish").
# Never commit the real file. Generate secrets with:
#   openssl rand -hex 24          passwords and storage keys (letters and digits)
#   openssl rand -hex 32          SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                 BOT_TOKEN_KEYS

# --- domain and HTTPS -------------------------------------------------------------
BASE_DOMAIN=javon.uz
# Let's Encrypt account e-mail (expiry warnings).
ACME_EMAIL=admin@javon.uz
# Store subdomains that may call the public storefront API from the browser.
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.javon\.uz$

# --- database (scripts/postgres-init runs once, on an empty volume) ----------------
POSTGRES_SUPERUSER_PASSWORD=
JAVON_OWNER_PASSWORD=
JAVON_APP_PASSWORD=

# --- file storage -------------------------------------------------------------------
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- secrets -----------------------------------------------------------------------
SECRET_KEY=
# Keep a copy with the passwords: without it the stores' bots must be reconnected.
BOT_TOKEN_KEYS=

# --- the platform bot (@BotFather; /setdomain javon.uz for the Login Widget) --------
TELEGRAM_LOGIN_BOT_TOKEN=
PLATFORM_BOT_USERNAME=

# --- where store owners pay the subscription ---------------------------------------
PLATFORM_CARD_NUMBER=
PLATFORM_CARD_HOLDER=
PLATFORM_SUPPORT_TELEGRAM=

# --- optional -------------------------------------------------------------------------
# Error tracking without personal data (utils/sentry.py). Empty = off.
SENTRY_DSN=
# API processes; one per CPU core.
API_WORKERS=2
LOG_LEVEL=INFO
BACKUP_KEEP_DAYS=14
