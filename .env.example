# Copy to .env. Read by the API (config.py) when running on your machine and by
# docker-compose.yml for variable substitution (Compose reads ./.env itself).
# Passwords go into connection URLs, so use URL-safe values:
#   openssl rand -hex 24

# --- Postgres roles (docker-compose / scripts/postgres-init) ----------------
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPER
JAVON_OWNER_PASSWORD=CHANGE_ME_OWNER
JAVON_APP_PASSWORD=CHANGE_ME_APP

# --- API on your machine (inside Compose these URLs are built from the passwords above)
# API role: owns no tables, so Row Level Security applies to it.
DATABASE_URL=postgresql+asyncpg://javon_app:CHANGE_ME_APP@localhost:5432/javon
# Schema owner: used only by Alembic.
MIGRATION_DATABASE_URL=postgresql+asyncpg://javon_owner:CHANGE_ME_OWNER@localhost:5432/javon
REDIS_URL=redis://localhost:6379/0

# --- general ----------------------------------------------------------------
ENV=local
DEBUG=true
LOG_LEVEL=INFO
BASE_DOMAIN=javon.uz
CORS_ORIGINS=["http://localhost:3000"]
