# Copy to .env. Read by the API (config.py) when running on your machine and by
# docker-compose.yml for variable substitution (Compose reads ./.env itself).
# Passwords go into connection URLs, so use URL-safe values:
#   openssl rand -hex 24

# --- Postgres roles (docker-compose / scripts/postgres-init) ----------------
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPER
JAVON_OWNER_PASSWORD=CHANGE_ME_OWNER
JAVON_APP_PASSWORD=CHANGE_ME_APP

# --- file storage (SeaweedFS, S3 API) ------------------------------------------
# docker-compose creates the storage user from these two (letters and digits only).
STORAGE_ACCESS_KEY=CHANGE_ME_STORAGE_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_SECRET
# The API on your machine reaches the storage here; inside Compose it is http://storage:8333.
STORAGE_ENDPOINT_URL=http://localhost:9010
STORAGE_BUCKET=javon-media
# How browsers load covers and logos.
STORAGE_PUBLIC_URL=http://localhost:9010/javon-media
# Card-transfer receipts: never public (scripts/storage_init.py creates it without a policy).
STORAGE_PRIVATE_BUCKET=javon-private

# --- API on your machine (inside Compose these URLs are built from the passwords above)
# API role: owns no tables, so Row Level Security applies to it.
DATABASE_URL=postgresql+asyncpg://javon_app:CHANGE_ME_APP@localhost:5440/javon
# Schema owner: used only by Alembic.
MIGRATION_DATABASE_URL=postgresql+asyncpg://javon_owner:CHANGE_ME_OWNER@localhost:5440/javon
REDIS_URL=redis://localhost:6385/0

# --- general ----------------------------------------------------------------
# Required: local, staging or production (test is set by pytest itself).
# /auth/dev-login exists only with ENV=local AND DEBUG=true.
ENV=local
DEBUG=true
LOG_LEVEL=INFO
BASE_DOMAIN=javon.uz
CORS_ORIGINS=["http://localhost:3000"]
# Store subdomains calling the public storefront API (no cookies), e.g.
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.javon\.uz
CORS_ORIGIN_REGEX=
# Signs order-tracking links. Required in production: openssl rand -hex 32
SECRET_KEY=

# --- sign-in ----------------------------------------------------------------
# Token of the PLATFORM bot from @BotFather; set its domain with /setdomain so the
# Telegram Login Widget works on the site. Empty = /auth/telegram answers 503
# (use /auth/dev-login locally instead). The same bot asks owners for their phone
# number and sends subscription reminders (services/platform_bot.py). Use a
# SEPARATE test bot locally: `python -m scripts.platform_bot` in polling mode
# removes the bot's webhook.
TELEGRAM_LOGIN_BOT_TOKEN=
PLATFORM_BOT_USERNAME=
# false only for http://localhost; must be true in production.
SESSION_COOKIE_SECURE=false

# --- store bots (Telegram) -----------------------------------------------------
# Each store connects its own bot in the admin panel; the token is kept encrypted.
# Encryption keys, comma-separated, newest first (old keys still decrypt during a
# rotation). Required in production; locally empty = a fixed dev-only key.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_TOKEN_KEYS=
# polling: locally, with `docker compose --profile telegram up -d` or
#          `python -m scripts.telegram_poll`.
# webhook: on a server; Telegram calls PUBLIC_API_URL/telegram/webhook/<bot id> (https only).
TELEGRAM_MODE=polling
PUBLIC_API_URL=http://localhost:8010
# Where each store's Mini App opens ({slug} is replaced); https only, else no menu button.
# MINI_APP_URL_TEMPLATE=https://{slug}.javon.uz/
# "Open in the admin panel" buttons in the staff group: <ADMIN_PANEL_URL>/<store id>/orders/<order id>
# ADMIN_PANEL_URL=https://javon.uz/admin
# Send the buyer's phone and address to the staff group? Off: Telegram's servers are
# abroad and the personal-data law wants such data kept in Uzbekistan.
# TELEGRAM_ORDER_CONTACTS=false

# --- subscriptions ----------------------------------------------------------------
# Where store owners pay the platform (shown in GET /tenants/{id}/subscription and
# in reminders). Empty = not shown.
PLATFORM_CARD_NUMBER=
PLATFORM_CARD_HOLDER=
PLATFORM_SUPPORT_TELEGRAM=
# TRIAL_DAYS=14
# SUBSCRIPTION_GRACE_DAYS=3

# --- links (defaults shown) ----------------------------------------------------------
# APP_URL=https://javon.uz                          invite links: APP_URL/taklif/<token>
# STOREFRONT_URL_TEMPLATE=https://{slug}.javon.uz/   QR codes and shelf labels

# --- monitoring (optional) ------------------------------------------------------------
# Sentry or GlitchTip; nothing personal is sent (utils/sentry.py). Empty = off.
SENTRY_DSN=

# --- limits (defaults shown; change only with a reason) ------------------------
# MAX_REQUEST_BODY_BYTES=1048576
# MAX_UPLOAD_BYTES=5242880
# MAX_IMPORT_ROWS=5000
# MAX_PENDING_BOOKS_PER_STORE=50
# MAX_PENDING_BOOKS_FROM_IMPORT=2000
# ORDER_RATE_LIMIT=10
# ORDER_RATE_WINDOW_S=600
# CARD_TRANSFER_HOLD_HOURS=24
# PROOF_RATE_LIMIT=20
# AUTH_RATE_LIMIT=20
# AUTH_RATE_WINDOW_S=600
# CLEANUP_AFTER_DAYS=30
# WORKER_CONCURRENCY=2

# --- tests (pytest) ---------------------------------------------------------
# Database tests are skipped while these are empty. The database name must end
# with _test: the tests wipe it. javon_test is created by scripts/postgres-init.
TEST_DATABASE_URL=postgresql+asyncpg://javon_app:CHANGE_ME_APP@localhost:5440/javon_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://javon_owner:CHANGE_ME_OWNER@localhost:5440/javon_test
